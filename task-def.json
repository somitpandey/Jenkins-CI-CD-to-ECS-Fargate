{
  "family": "springboot-demo-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::730335459381:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "springboot-demo",
      "image": "730335459381.dkr.ecr.us-east-1.amazonaws.com/springboot-demo:6",
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080
        }
      ]
    }
  ]
}
